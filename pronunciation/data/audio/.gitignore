# Ignore patterns moved to repo-root .git/info/exclude so sky's file_mounts
# will upload these files to the cluster — sky's rsync respects .gitignore
# but not .git/info/exclude. WAV files, derived phonemes.jsonl, and derived
# vad.jsonl remain untracked in git but will be transmitted to training
# clusters when file_mounts pushes data/audio/.
